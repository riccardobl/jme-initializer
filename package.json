{
  "name": "jme-initializer",
  "version": "3.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:template && vite",
    "build:template": "node --disable-warning=ExperimentalWarning scripts/build-template.ts",
    "build:app": "vite build",
    "build:embed": "vite build --config vite.embed.config.ts",
    "build": "npm run build:template && npm run build:app && npm run build:embed",
    "test": "npm run build:template && vitest run",
    "check": "tsc --noEmit && npm test && npm run build"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
