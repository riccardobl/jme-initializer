plugins { id("com.android.application") version "[ANDROID_GRADLE_PLUGIN_VERSION]" }
java {
    toolchain.languageVersion.set(JavaLanguageVersion.of([JAVA_VERSION]))
}
android {
    namespace = "[GAME_PACKAGE].android"
    compileSdk = [ANDROID_COMPILE_SDK]
    defaultConfig {
        applicationId = "[GAME_PACKAGE]"
        minSdk = [ANDROID_MIN_SDK]
        targetSdk = [ANDROID_TARGET_SDK]
        versionCode = 1
        versionName = "1.0.0"
        ndk { abiFilters += listOf("arm64-v8a", "x86_64") }
    }
    compileOptions {
        sourceCompatibility = JavaVersion.toVersion([JAVA_VERSION])
        targetCompatibility = JavaVersion.toVersion([JAVA_VERSION])
        isCoreLibraryDesugaringEnabled = true
    }
    sourceSets["main"].assets.srcDir("../app/src/main/resources")
    packaging { resources.excludes += "META-INF/DEPENDENCIES" }
}
dependencies {
    implementation(platform("org.jetbrains.kotlin:kotlin-bom:1.8.22"))
    implementation(project(":app"))
[ANDROID_ENGINE_DEPENDENCIES]
    implementation("androidx.fragment:fragment:1.8.9")
    coreLibraryDesugaring("com.android.tools:desugar_jdk_libs:2.1.5")
}

apply(from = rootProject.file("gradle/libs/android-icon-gen.gradle"))

val generateAndroidLauncherIcons = tasks.register("generateAndroidLauncherIcons") {
    inputs.file(rootProject.file("icon.png"))
    outputs.dir(layout.projectDirectory.dir("src/main/res"))
    doLast {
        val generator = gradle.extra["generateAndroidIcons"] as groovy.lang.Closure<*>
        generator.call(rootProject.file("icon.png").path, layout.projectDirectory.dir("src/main/res").asFile.path)
    }
}

tasks.named("preBuild").configure { dependsOn(generateAndroidLauncherIcons) }
