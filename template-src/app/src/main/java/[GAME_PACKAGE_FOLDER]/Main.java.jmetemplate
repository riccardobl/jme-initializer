package [GAME_PACKAGE];

import com.jme3.app.SimpleApplication;
import com.jme3.material.Material;
import com.jme3.math.ColorRGBA;
import com.jme3.scene.Geometry;
import com.jme3.scene.shape.Box;

/** Shared game code. Keep platform APIs in their launcher modules. */
public class Main extends SimpleApplication {
    private Geometry cube;

    @Override
    public void simpleInitApp() {
        cube = new Geometry("Welcome", new Box(1, 1, 1));
        Material material = new Material(assetManager, "Common/MatDefs/Misc/Unshaded.j3md");
        material.setColor("Color", new ColorRGBA(0.15f, 0.65f, 1f, 1f));
        cube.setMaterial(material);
        rootNode.attachChild(cube);
        viewPort.setBackgroundColor(new ColorRGBA(0.035f, 0.05f, 0.08f, 1f));
        flyCam.setMoveSpeed(5f);
    }

    @Override
    public void simpleUpdate(float timePerFrame) {
        cube.rotate(0.2f * timePerFrame, 0.5f * timePerFrame, 0);
    }
}
